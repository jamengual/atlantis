package webui

import (
	"strconv"
	"strings"
)

const traceCapNote = "Timing traces live in memory on the replica that ran the job, next to its output, and are removed with it. Other replicas and restarts don't have them. Durable storage (ADR 0005) will share them."

func timingHref(base string, j Job) string {
	return jobHref(base, j.ID) + "/timing"
}

// visibleAttributes are the attributes whose values were kept.
func visibleAttributes(s TraceSpan) []TraceAttribute {
	var out []TraceAttribute
	for _, a := range s.Attributes {
		if !a.Hidden {
			out = append(out, a)
		}
	}
	return out
}

// hiddenAttributeKeys names the attributes whose values were not kept.
func hiddenAttributeKeys(s TraceSpan) []string {
	var out []string
	for _, a := range s.Attributes {
		if a.Hidden {
			out = append(out, a.Key)
		}
	}
	return out
}

func rowClasses(r waterfallRow) string {
	c := []string{"wf-row", depthClass(r.Depth), categoryClass(r.Span.Category)}
	if r.Failed {
		c = append(c, "err")
	}
	if r.Critical {
		c = append(c, "crit")
	}
	if r.Fold() {
		c = append(c, "fold")
	}
	if r.HTTPGroup {
		c = append(c, "group")
	}
	if r.Span.Running() && !r.Fold() && !r.HTTPGroup {
		c = append(c, "live")
	}
	return strings.Join(c, " ")
}

// spanSubject is the resource or provider a span is about, shown before
// its operation name so rows like "Plan resource instance changes" can be
// told apart.
func spanSubject(s TraceSpan) string {
	var provider string
	for _, a := range s.Attributes {
		if a.Hidden {
			continue
		}
		switch a.Key {
		case "opentofu.resource_instance.address":
			return a.Value
		case "opentofu.provider.address":
			provider = a.Value
		}
	}
	if provider == "" || strings.Contains(s.Name, provider) {
		return ""
	}
	for _, reg := range []string{"registry.opentofu.org/", "registry.terraform.io/"} {
		provider = strings.TrimPrefix(provider, reg)
	}
	return provider
}

// groupLabel names an HTTP group row: "12 HTTP requests · 1.4s total".
func groupLabel(r waterfallRow) string {
	return r.Span.Name + " · " + formatSpanDuration(r.HTTPTotal) + " total"
}

func rowLabel(r waterfallRow) string {
	label := r.Span.Name
	if subject := spanSubject(r.Span); subject != "" {
		label = subject + " " + label
	}
	label += ", " + categoryLabel(r.Span) + ", " + formatSpanDuration(r.Duration)
	if r.Failed {
		label += ", failed"
	}
	if r.Critical {
		label += ", on the critical path"
	}
	return label
}

// rowSearchText is what the name filter matches: the span's name and the
// resource, provider, or module it is about.
func rowSearchText(s TraceSpan) string {
	parts := []string{s.Name}
	for _, a := range s.Attributes {
		switch a.Key {
		case "opentofu.resource_instance.address", "opentofu.provider.address", "opentofu.module.name":
			if !a.Hidden {
				parts = append(parts, a.Value)
			}
		}
	}
	return strings.ToLower(strings.Join(parts, " "))
}

func durNanos(d int64) string { return strconv.FormatInt(d, 10) }

func spanStatus(r waterfallRow) string {
	switch {
	case r.Failed:
		return "Failed"
	case r.Span.Running():
		return "Running"
	}
	return "OK"
}

// benignNote explains a span the tool reported as an error that is not
// counted as failed.
func benignNote(r waterfallRow) string {
	how := "with no diagnostics"
	if r.Span.Message == "" {
		how = "without a message"
	}
	return "Reported as an error by " + reportedBy(r.Span.Source) + " " + how + "; the command succeeded."
}

templ timingPage(m meta, d timingData) {
	@layout(m) {
		@jobHeader(m, d.Job, timingHref(m.Base, d.Job))
		@jobTabs(m, d.Job, "timing")
		<section class="panel">
			<trace-view
				data-src={ timingHref(m.Base, d.Job) + "?partial=1" }
				if d.Trace.Status == TraceReady && !(d.Trace.Finished && !d.Job.Running()) {
					data-events={ timingHref(m.Base, d.Job) + "/events" }
				}
			>
				<div data-wf-body>
					@timingBody(m.Base, d)
				</div>
			</trace-view>
			if !m.Caps.SharedTraces {
				@capabilityNote(traceCapNote)
			}
		</section>
	}
}

templ timingBody(base string, d timingData) {
	switch d.Trace.Status {
		case TraceOff:
			<p class="empty">Timing traces are off on this server. Start Atlantis with the web-traces experiment to record them for new jobs.</p>
		case TraceMissing:
			<p class="empty">This replica has no timing trace for this job. Traces are recorded only for jobs this replica ran after it started with the web-traces experiment.</p>
		default:
			@waterfallView(d)
	}
}

templ waterfallView(d timingData) {
	<div class="wf-summary">
		<div class="stat"><span class="muted">Duration</span><b class="num">{ formatSpanDuration(d.W.Total) }</b></div>
		<div class="stat"><span class="muted">Spans</span><b class="num">{ strconv.Itoa(d.W.Spans) }</b></div>
		<div class="stat">
			<span class="muted">Failed</span>
			<b
				if d.W.Errors > 0 {
					class="num bad-text"
				} else {
					class="num"
				}
			>{ strconv.Itoa(d.W.Errors) }</b>
		</div>
		<div class="stat">
			<span class="muted">Status</span>
			if d.W.Running {
				@pill(toneRun, "Recording")
			} else {
				@pill(toneNeutral, "Complete")
			}
		</div>
	</div>
	for _, n := range d.Trace.Notes {
		<p class="wf-note">{ n }</p>
	}
	if d.Trace.Dropped > 0 {
		<p class="wf-note">This job reported more spans than Atlantis keeps per job. { strconv.Itoa(d.Trace.Dropped) } spans were not kept.</p>
	}
	if len(d.W.Rows) == 0 {
		<p class="empty">No spans yet. They appear as the job runs.</p>
	} else {
		<div class="wf-tools" data-wf-tools hidden>
			<label class="muted" for="wf-filter">Find span or resource</label>
			<input id="wf-filter" type="search" data-wf-filter placeholder="aws_instance" autocomplete="off"/>
			<button type="button" class="chip" data-wf-sort aria-pressed="false">Slowest first</button>
			<button type="button" class="chip" data-wf-critical aria-pressed="false">Critical path only</button>
			<span class="wf-legend grow-right" aria-label="Colors">
				<span><i class="sw cat-atlantis"></i>Atlantis</span>
				<span><i class="sw cat-tool"></i>{ d.W.Tool }</span>
				<span><i class="sw cat-provider"></i>Provider</span>
				<span><i class="sw cat-resource"></i>Resource</span>
				<span><i class="sw err"></i>Failed</span>
			</span>
		</div>
		<div class="wf-layout">
			<div class="wf-scroll" tabindex="0" aria-label="Span timeline, scrolls sideways">
				<div class="wf" role="list" aria-label="Spans in start order" data-wf-rows>
					<div class="wf-row wf-axis" aria-hidden="true">
						<div class="wf-name muted">Span</div>
						<div class="wf-bar wf-ticks">
							for _, t := range d.W.Ticks {
								<span>{ t }</span>
							}
						</div>
						<div class="wf-dur muted">Time</div>
					</div>
					for _, r := range d.W.Rows {
						@waterfallRowView(r)
					}
				</div>
			</div>
			if d.W.Truncated > 0 || d.W.Folded > 0 {
				<p class="capnote">
					if d.W.Folded > 0 {
						{ strconv.Itoa(d.W.Folded) } short spans are grouped into "more spans" rows.
					}
					if d.W.Truncated > 0 {
						{ strconv.Itoa(d.W.Truncated) } more rows are not shown. The API returns every span.
					}
				</p>
			}
			<aside class="wf-details" id="wf-detail" aria-live="polite" aria-label="Span details">
				<p class="muted" data-wf-empty>Select a span to see its details.</p>
				for _, r := range d.W.Rows {
					if !r.HTTPGroup {
						@spanDetail(r, d.Trace.AllAttributes)
					}
				}
			</aside>
		</div>
		<section class="wf-top">
			<div class="wf-top-head">
				<h2>Slowest spans</h2>
				if d.W.HTTPRequests > 0 {
					<button type="button" class="chip" data-wf-http aria-pressed="false" aria-controls="wf-top-all wf-top-main" hidden>Include HTTP requests</button>
				}
			</div>
			@slowestList("wf-top-main", d.W.Slowest, false)
			if d.W.HTTPRequests > 0 {
				@slowestList("wf-top-all", d.W.SlowestAll, true)
			}
		</section>
	}
}

templ slowestList(id string, rows []waterfallRow, hidden bool) {
	<ol id={ id } hidden?={ hidden }>
		for _, r := range rows {
			<li>
				<button type="button" class="linkbtn" data-wf-goto={ r.Span.ID }>
					if subject := spanSubject(r.Span); subject != "" {
						{ subject } <span class="wf-op">{ r.Span.Name }</span>
					} else {
						{ r.Span.Name }
					}
				</button>
				<span class="muted">{ categoryLabel(r.Span) }</span>
				if r.Failed {
					<span class="bad-text">Failed</span>
				}
				<span class="num grow-right">{ formatSpanDuration(r.Duration) }</span>
			</li>
		}
	</ol>
}

templ waterfallRowView(r waterfallRow) {
	if r.HTTPGroup {
		@httpGroupRowView(r)
	} else {
		@spanRowView(r)
	}
}

// httpGroupRowView is the row that stands for HTTP requests. Its label
// expands and collapses them; the requests start collapsed once scripts
// run.
templ httpGroupRowView(r waterfallRow) {
	<div
		class={ rowClasses(r) }
		role="listitem"
		data-id={ r.Span.ID }
		data-depth={ strconv.Itoa(r.Depth) }
		data-dur={ durNanos(int64(r.Duration)) }
		data-i={ strconv.Itoa(r.Index) }
		data-name=""
		data-group="1"
	>
		<div class="wf-name">
			<span class="wf-twisty wf-caret" aria-hidden="true"></span>
			<button type="button" class="wf-label" data-wf-toggle aria-expanded="true" title={ groupLabel(r) }>{ groupLabel(r) }</button>
		</div>
		<div class="wf-bar">
			<svg viewBox="0 0 1000 14" preserveAspectRatio="none" aria-hidden="true" focusable="false">
				<rect x={ r.barX() } y="2" width={ r.barWidth() } height="10"></rect>
			</svg>
		</div>
		<div class="wf-dur num">{ formatSpanDuration(r.Duration) }</div>
	</div>
}

templ spanRowView(r waterfallRow) {
	<div
		class={ rowClasses(r) }
		role="listitem"
		data-id={ r.Span.ID }
		data-depth={ strconv.Itoa(r.Depth) }
		data-dur={ durNanos(int64(r.Duration)) }
		data-i={ strconv.Itoa(r.Index) }
		data-name={ rowSearchText(r.Span) }
		if r.Critical {
			data-crit="1"
		}
		if r.Group != "" {
			data-group-of={ r.Group }
		}
	>
		<div class="wf-name">
			if r.HasChildren {
				<button type="button" class="wf-twisty" data-wf-toggle aria-expanded="true" aria-label={ "Collapse " + r.Span.Name }></button>
			} else {
				<span class="wf-twisty" aria-hidden="true"></span>
			}
			<button type="button" class="wf-label" data-wf-select aria-controls="wf-detail" aria-label={ rowLabel(r) }>
				if subject := spanSubject(r.Span); subject != "" {
					{ subject } <span class="wf-op">{ r.Span.Name }</span>
				} else {
					{ r.Span.Name }
				}
			</button>
		</div>
		<div class="wf-bar">
			<svg viewBox="0 0 1000 14" preserveAspectRatio="none" aria-hidden="true" focusable="false">
				<rect x={ r.barX() } y="2" width={ r.barWidth() } height="10"></rect>
			</svg>
		</div>
		<div class="wf-dur num">{ formatSpanDuration(r.Duration) }</div>
	</div>
}

templ spanDetail(r waterfallRow, all bool) {
	<div class="wf-detail" data-wf-detail={ r.Span.ID } hidden>
		if subject := spanSubject(r.Span); subject != "" {
			<h3>{ subject } <span class="wf-op">{ r.Span.Name }</span></h3>
		} else {
			<h3>{ r.Span.Name }</h3>
		}
		<dl class="kv">
			<dt>Kind</dt>
			<dd>{ categoryLabel(r.Span) }</dd>
			if r.Span.Source != "" && !r.Fold() {
				<dt>Reported by</dt>
				<dd>{ reportedBy(r.Span.Source) }</dd>
			}
			<dt>Starts at</dt>
			<dd class="num">+{ formatSpanDuration(r.StartOffset) }</dd>
			<dt>Duration</dt>
			<dd class="num">{ formatSpanDuration(r.Duration) }</dd>
			if !r.Fold() {
				<dt>Status</dt>
				<dd
					if r.Failed {
						class="bad-text"
					}
				>{ spanStatus(r) }</dd>
				if r.Benign {
					<dt>Reported status</dt>
					<dd data-wf-benign>{ benignNote(r) }</dd>
				}
				if r.Span.Message != "" {
					<dt>Message</dt>
					<dd class="mono">{ r.Span.Message }</dd>
				}
				<dt>Critical path</dt>
				<dd>
					if r.Critical {
						Yes, the job waited on this span.
					} else {
						No
					}
				</dd>
			}
		</dl>
		if r.Fold() {
			<p class="muted">{ strconv.Itoa(r.More) } spans that each took under half a percent of the job are grouped here.</p>
		}
		if attrs := visibleAttributes(r.Span); len(attrs) > 0 {
			<ul class="attrs">
				for _, a := range attrs {
					<li><span class="path mono">{ a.Key }</span><span class="vals mono">{ a.Value }</span></li>
				}
			</ul>
		}
		if hidden := hiddenAttributeKeys(r.Span); len(hidden) > 0 {
			<p class="muted wf-hidden">
				{ strconv.Itoa(len(hidden)) } attribute values hidden because they can hold URLs, headers, or paths: <span class="mono">{ strings.Join(hidden, ", ") }</span>.
				if !all {
					An administrator can show them with --web-traces-all-attributes.
				}
			</p>
		}
	</div>
}
